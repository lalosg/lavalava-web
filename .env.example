# Google Places API (New) — for fetching live Google reviews
# Enable "Places API (New)" in Google Cloud Console → LavaLava POS project
GOOGLE_PLACES_API_KEY=your_key_here

# Public site origin. Used by lib/google-reviews.ts as the `Referer` header so the
# Places API key passes HTTP-referrer restrictions. Must match the deployed origin
# exactly — on production set this to https://lavalava.vip, or the key is rejected.
# Falls back to https://lavalava-web.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://lavalava.vip
