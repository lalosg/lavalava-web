# ── Google Places API (New) — live Google reviews ────────────────────────────
# Enable "Places API (New)" in Google Cloud Console → LavaLava POS project.
#
# Without this key, fetchGoogleReviews() returns [] and the reviews section falls back
# to three hardcoded cards. That is a SILENT downgrade — the page still renders, so it
# is easy to ship without noticing.
GOOGLE_PLACES_API_KEY=your_key_here

# ── Public site origin ───────────────────────────────────────────────────────
# lib/google-reviews.ts sends this as the `Referer` so the Places key passes its
# HTTP-referrer restrictions. Must match the deployed origin exactly.
#
# ⚠️ LAUNCH BLOCKER, verified 2026-09-24: the key's referrer allowlist currently
# accepts https://lavalava-web.vercel.app and http://localhost:3000, and REJECTS
# https://lavalava.vip with API_KEY_HTTP_REFERRER_BLOCKED. Setting this to the real
# domain without first adding lavalava.vip to the key's allowlist in Google Cloud
# Console will kill live reviews the moment the domain goes live — silently.
NEXT_PUBLIC_SITE_URL=https://lavalava.vip

# ── Instagram API with Instagram Login — live promo feed ─────────────────────
# A long-lived (60-day) token for the @lavalava.vip PROFESSIONAL account.
# Meta App Dashboard → Instagram → "API setup with Instagram business login"
# → Generate token. Scope: instagram_business_basic. No App Review needed to
# read your own account.
#
# ⚠️ EXPIRES AFTER 60 DAYS. lib/instagram.ts exports refreshToken(), but the
# refreshed value CANNOT be written back here — env vars are read-only at
# runtime. Production must persist it (POS Supabase) and refresh on a schedule.
# This variable is the POC path only.
#
# Verify with: curl localhost:3000/api/instagram/health
INSTAGRAM_ACCESS_TOKEN=your_long_lived_token_here

# Numeric Instagram Business Account id, shown next to the account in the Meta
# App Dashboard under "2. Generar tokens de acceso". Required by the facebook
# transport, which addresses the account by id rather than as /me.
INSTAGRAM_USER_ID=17841464811332093

# Which graph answers this token: "facebook" (unified login, System User token,
# never expires) or "instagram" (older Instagram Login, 60-day token).
# Leave unset to default to "facebook"; /api/instagram/health reports which one
# actually works, and that value is what to pin here.
INSTAGRAM_TRANSPORT=facebook
