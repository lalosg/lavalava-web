# ── Google Places API (New) — live Google reviews ────────────────────────────
# Enable "Places API (New)" in Google Cloud Console → LavaLava POS project.
#
# Without this key, fetchGoogleReviews() returns [] and the reviews section falls back
# to three hardcoded cards. That is a SILENT downgrade — the page still renders, so it
# is easy to ship without noticing.
GOOGLE_PLACES_API_KEY=your_key_here

# ── Public site origin ───────────────────────────────────────────────────────
# lib/google-reviews.ts sends this as the `Referer` so the Places key passes its
# HTTP-referrer restrictions. Must match the deployed origin exactly.
#
# ⚠️ LAUNCH BLOCKER, verified 2026-09-24: the key's referrer allowlist currently
# accepts https://lavalava-web.vercel.app and http://localhost:3000, and REJECTS
# https://lavalava.vip with API_KEY_HTTP_REFERRER_BLOCKED. Setting this to the real
# domain without first adding lavalava.vip to the key's allowlist in Google Cloud
# Console will kill live reviews the moment the domain goes live — silently.
NEXT_PUBLIC_SITE_URL=https://lavalava.vip
